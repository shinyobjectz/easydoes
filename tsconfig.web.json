{
  "compilerOptions": {
    "composite": true, "tsBuildInfoFile": "node_modules/.tmp/web.tsbuildinfo",
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "types": ["vite/client"], "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["web/src", "shared"]
}
